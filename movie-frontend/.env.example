# Base URL of the Spring Boot backend (no trailing slash).
# The backend CORS config only allows http://localhost:5173 and http://localhost:3000 by default.
VITE_API_BASE_URL=http://localhost:8080

# Alternative: leave VITE_API_BASE_URL empty to call same-origin "/api/..." and let
# `npm run dev` / `npm run preview` (or your reverse proxy in production) forward it.
# VITE_DEV_PROXY_TARGET=http://localhost:8080
