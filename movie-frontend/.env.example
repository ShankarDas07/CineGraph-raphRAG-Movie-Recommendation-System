# Copy this file to ".env" (or ".env.local") and change the values if you need to.
# Vite only exposes variables that start with VITE_ to the browser code.
# Never put secrets (API keys, passwords, tokens) in these files - they end up inside the built JavaScript.

# Where the Spring Boot backend lives.
#   not set at all -> http://localhost:8080  (default, see src/lib/env.ts)
#   empty value    -> same-origin URLs like /api/v1/... (use behind a reverse proxy)
VITE_API_BASE_URL=http://localhost:8080

# Only used by "npm run dev" and "npm run preview" when VITE_API_BASE_URL is empty:
# Vite forwards /api/* to this address (see vite.config.ts). Default is http://localhost:8080.
# VITE_DEV_PROXY_TARGET=http://localhost:8080
